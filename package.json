{
  "name": "opcontroller",
  "private": true,
  "version": "0.1.0",
  "workspaces": [
    "desktop"
  ],
  "scripts": {
    "dev:desktop": "npm --workspace desktop run dev",
    "build:desktop": "npm --workspace desktop run build",
    "build:mac:internal": "npm --workspace desktop run build:mac && bash scripts/package-mac-internal.sh",
    "build:win": "npm --workspace desktop run build:win",
    "package:win": "powershell -NoProfile -ExecutionPolicy Bypass -File scripts/package-windows.ps1",
    "tauri:dev": "npm --workspace desktop run tauri:dev"
  }
}
