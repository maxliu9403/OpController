{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "OpController",
  "version": "0.1.12",
  "identifier": "com.max.opcontroller",
  "build": {
    "frontendDist": "../dist",
    "beforeDevCommand": "npm run dev",
    "devUrl": "http://localhost:4173"
  },
  "app": {
    "windows": [
      {
        "title": "OpController Desktop",
        "width": 1560,
        "height": 980,
        "minWidth": 1280,
        "minHeight": 820,
        "center": true
      }
    ],
    "security": {
      "csp": null
    }
  },
  "plugins": {
    "updater": {
      "pubkey": "",
      "endpoints": []
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "resources": {
      "../../runtime/dist/opcontroller-runtime": "runtime-dist/opcontroller-runtime",
      "../../shared": "shared",
      "update-config.json": "update-config.json"
    },
    "windows": {
      "nsis": {
        "installerHooks": "installer-hooks.nsh"
      }
    }
  }
}
